---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Me";
---

<BaseLayout pageTitle={pageTitle}>
	<h1>Hey!</h1>
	<p>I'm Taxolotl. You can call me Tax. <sub>or Taxie if you're feelin' frisky</sub></p>
	<br>
	<p>I don't actually know what I am. I program. I game. I stream if I'm feeling very very extroverted. </p>
	<p>I'm majoring in cybersecurity. I have an interest in linguistics, chemistry, archeology and just about everything else. </p>
	<br>
	<p>All I know for sure is that Jesus of Nazareth is the only one who can save us all</p>
</BaseLayout>
